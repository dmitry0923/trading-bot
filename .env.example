# Обязательные и рекомендованные переменные окружения (docker compose).
#
# `docker-compose.yml` валидирует часть ключей через `${VAR:?}`: без них стек НЕ
# поднимется. Секреты не коммитим — файл служит чек-листом для VM/CI (скан-8 P1).

# --- обязательные (compose упадёт без них) ---
DB_PASS=            # пароль postgresql (и приложения)
JWT_SECRET=         # >= 32 байт, HS256
AUTH_USER=          # admin-логин UI/API
AUTH_PASSWORD=      # admin-пароль

# --- обязательные для наблюдаемости ---
METRICS_SCRAPE_TOKEN=      # Bearer для /actuator/prometheus (пустой = 401)
GRAFANA_ADMIN_PASSWORD=

# --- Alor ---
ALOR_TOKEN=
ALOR_REFRESH_TOKEN=
ALOR_PORTFOLIO=            # LIVE: реальный портфель (не D12345)
ALOR_EXCHANGE=MOEX
ALOR_WS_ORDERS_ENABLED=false   # true = ордера через WS (primary), false = REST

# --- LLM ---
LLM_PROVIDER=ROUTER_AI
LLM_API_KEY=
ROUTER_AI_MODEL=auto

# --- торговля / LIVE-guard ---
TRADING_MODE=SIMULATION        # LIVE только через deploy-live (workflow_dispatch + approval)
TRADING_TICKERS=CNYRUBF
LIVE_TICKERS_ALLOWLIST=CNYRUBF # в LIVE пустой список = блок ВСЕХ входов (fail-closed)
MAX_OPEN_POS=3

# --- прочее ---
TZ=Europe/Moscow
JWT_COOKIE_SECURE=true         # false только для локального http
