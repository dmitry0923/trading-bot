<?xml version="1.0" encoding="utf-8"?>
<baseline version="1.0">
    <!--
        ═══════════════════════════════════════════════════════════════
        KTLINT BASELINE - ТОЛЬКО КРИТИЧЕСКИЕ ИСКЛЮЧЕНИЯ
        ═══════════════════════════════════════════════════════════════

        В этом файле перечислены ТОЛЬКО те ошибки, которые НЕЛЬЗЯ ИСПРАВИТЬ:
        1. Автогенерированный код (build, generated)
        2. Код сторонних библиотек
        3. Неизбежные ограничения фреймворка
        4. Специальные случаи для Spring Boot

        ⚠️ ВСЕ ОСТАЛЬНЫЕ ОШИБКИ ДОЛЖНЫ БЫТЬ ИСПРАВЛЕНЫ В КОДЕ!

        Источники правил соответствуют ktlint 1.8.0. Правил
        standard:unused-parameter / standard:unused-private-member
        в ktlint 1.8.0 НЕ СУЩЕСТВУЕТ, поэтому они не перечислены.
        ═══════════════════════════════════════════════════════════════
    -->

    <!-- ============================================================= -->
    <!-- 1. СИСТЕМНЫЕ ФАЙЛЫ И СБОРКА                                  -->
    <!-- ============================================================= -->
    <file name="build.gradle.kts">
        <error line="1" column="1" source="standard:final-newline" />
    </file>

    <!-- ============================================================= -->
    <!-- 2. АВТОГЕНЕРИРОВАННЫЙ КОД                                    -->
    <!-- ============================================================= -->
    <file name="**/generated/**/*.kt">
        <error line="1" column="1" source="standard:no-wildcard-imports" />
        <error line="1" column="1" source="standard:no-unused-imports" />
        <error line="1" column="1" source="standard:max-line-length" />
    </file>

    <file name="**/build/**/*.kt">
        <error line="1" column="1" source="standard:no-wildcard-imports" />
        <error line="1" column="1" source="standard:no-unused-imports" />
        <error line="1" column="1" source="standard:max-line-length" />
    </file>

    <!-- ============================================================= -->
    <!-- 3. ОСОБЫЕ СЛУЧАИ - КОНКРЕТНЫЕ КЛАССЫ                       -->
    <!-- ============================================================= -->

    <!-- Enums часто содержат поля для Java/Kotlin совместимости -->
    <file name="**/model/Enums.kt">
        <error line="1" column="1" source="standard:enum-wrapping" />
    </file>

    <file name="**/model/ExecutionReport.kt">
        <error line="1" column="1" source="standard:enum-wrapping" />
    </file>

    <file name="**/model/OrderOutbox.kt">
        <error line="1" column="1" source="standard:enum-wrapping" />
    </file>

    <!-- ============================================================= -->
    <!-- 4. ПРОЧИЕ ФАЙЛЫ, КОТОРЫЕ МОГУТ ВЫЗЫВАТЬ ПРОБЛЕМЫ           -->
    <!-- ============================================================= -->

    <!-- Файлы с большим количеством параметров в конструкторах -->
    <file name="**/model/Candle.kt">
        <error line="1" column="1" source="standard:max-line-length" />
    </file>

    <!-- Файлы с длинными сигнатурами методов -->
    <file name="**/service/**/*Service.kt">
        <error line="1" column="1" source="standard:function-signature" />
        <error line="1" column="1" source="standard:max-line-length" />
    </file>
</baseline>
