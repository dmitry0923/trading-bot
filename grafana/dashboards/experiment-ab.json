    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "unit": "currencyRUB",
          "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "VARIANT" }, "properties": [ { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } } ] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "experiment_outcome_pnl_profit_total{arm=\"CONTROL\"} - experiment_outcome_pnl_loss_total{arm=\"CONTROL\"}",
          "legendFormat": "CONTROL (net)"
        },
        {
          "refId": "B",
          "expr": "experiment_outcome_pnl_profit_total{arm=\"VARIANT\"} - experiment_outcome_pnl_loss_total{arm=\"VARIANT\"}",
          "legendFormat": "VARIANT (net)"
        }
      ],
      "title": "Net P&L by arm (cumulative)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
