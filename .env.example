# === API Keys ===
KIMI_API_KEY=sk-your-kimi-key-here
ALOR_TOKEN=your-alor-token
ALOR_REFRESH_TOKEN=your-alor-refresh-token
ALOR_PORTFOLIO=D12345

# === Database ===
# Для локального запуска:
DB_URL=jdbc:postgresql://postgres:5432/trading_bot
DB_USER=trader
DB_PASS=your-strong-password

# Для Managed PostgreSQL Cloud.ru:
# DB_URL=jdbc:postgresql://c-c9q...postgres.cloud.ru:5432/trading_bot

# === Redis ===
# Для локального запуска:
REDIS_HOST=redis
REDIS_PORT=6379

# Для Managed Redis Cloud.ru:
# REDIS_HOST=c-c9q...redis.cloud.ru
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# === Trading Settings ===
TRADING_MODE=SIMULATION
BOT_INTERVAL_MS=300000
STRATEGY_INTERVAL_MS=600000
MONITOR_INTERVAL_MS=600000
MAX_OPEN_POS=0

# === Cloud.ru Registry ===
CLOUDRU_REGISTRY_USERNAME=your-registry-username
CLOUDRU_REGISTRY_PASSWORD=your-registry-password
