<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
        Structured JSON logging в stdout (для Docker / k8s).
        Поля из MDC: trace_id, cycle_id, ticker, agent (заполняются TraceContext).
        В тестовом профиле / локальном debug — обычный текст (logback-test.xml
        имеет приоритет над logback-spring.xml в classpath тестов).
    -->
    <springProfile name="!json-logs-off">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"application":"mmvb-trading-bot-v2"}</customFields>
                <includeMdcKeyName>trace_id</includeMdcKeyName>
                <includeMdcKeyName>cycle_id</includeMdcKeyName>
                <includeMdcKeyName>ticker</includeMdcKeyName>
                <includeMdcKeyName>agent</includeMdcKeyName>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
